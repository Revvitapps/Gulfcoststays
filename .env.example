# Everything is optional. The app runs with none of these set.

# Search indexing is ON for the Vercel production deployment and OFF for previews,
# local builds and *.vercel.app hosts, with nothing set. "off" is a kill switch
# for production; "on" forces indexing anywhere (testing only).
SITE_INDEXING=

# GA4 measurement ID (G-XXXXXXXXXX). Loads on Vercel production only. Redeploy after setting.
NEXT_PUBLIC_GA_ID=

# Search Console / Bing meta verification, if DNS TXT verification is not used.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Where booking requests and inquiries are forwarded (Slack incoming webhook,
# Zapier, Make, StayOS endpoint). Unset: requests are logged on the server only.
PIPELINE_WEBHOOK_URL=

# StayOS direct-booking adapter (future). Unset: the mock adapter quotes from
# data/island-retreat.json and takes requests, no payment.
STAYOS_API_URL=
STAYOS_API_KEY=

# Public contact details shown in the app. Phone is a placeholder until set.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=bookings@gulfcoaststays.co

# Listing links shown on the Book page once the home is live on each site.
NEXT_PUBLIC_AIRBNB_URL=
NEXT_PUBLIC_VRBO_URL=

# Social profiles. Listing and social URLs also feed sameAs in the schema.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
