# Everything is optional. The app runs with none of these set.

# Turns on search indexing (robots.txt, sitemap, meta robots). Off by default so
# previews stay out of Google. Set to "on" in Vercel production at launch, then redeploy.
SITE_INDEXING=

# Where booking requests and inquiries are forwarded (Slack incoming webhook,
# Zapier, Make, StayOS endpoint). Unset: requests are logged on the server only.
PIPELINE_WEBHOOK_URL=

# StayOS direct-booking adapter (future). Unset: the mock adapter quotes from
# data/island-retreat.json and takes requests, no payment.
STAYOS_API_URL=
STAYOS_API_KEY=

# Public contact details shown in the app. Phone is a placeholder until set.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=bookings@gulfcoaststays.co

# Listing links shown on the Book page once the home is live on each site.
NEXT_PUBLIC_AIRBNB_URL=
NEXT_PUBLIC_VRBO_URL=
